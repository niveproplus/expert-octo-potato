{
  "name": "Codespaces Desktop (VNC)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "vscode",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },
  "forwardPorts": [6080, 5901],
  "portsAttributes": {
    "6080": {
      "label": "noVNC Desktop",
      "onAutoForward": "notify"
    },
    "5901": {
      "label": "VNC Desktop"
    }
  },
  "postCreateCommand": "echo 'Desktop ready. Open port 6080 and use password: vscode'"
}
